<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="OmniConvert.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:OmniConvert.Views"
    Title="OmniConvert">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop/>
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Border x:Name="BackgroundOverlay"
                Grid.RowSpan="2"
                Background="#80FFFFFF"
                IsHitTestVisible="False"/>

        <Grid x:Name="AppTitleBar" Height="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftPaddingColumn" Width="0"/>
                <ColumnDefinition x:Name="IconColumn" Width="Auto"/>
                <ColumnDefinition x:Name="TitleColumn" Width="Auto"/>
                <ColumnDefinition x:Name="LeftDragColumn" Width="*"/>
                <ColumnDefinition x:Name="MinButtonColumn" Width="Auto"/>
                <ColumnDefinition x:Name="MaxButtonColumn" Width="Auto"/>
                <ColumnDefinition x:Name="CloseButtonColumn" Width="Auto"/>
                <ColumnDefinition x:Name="RightPaddingColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <Image x:Name="TitleBarIcon"
                   Source="ms-appx:///Assets/Tiles/GalleryIcon.ico"
                   Grid.Column="1"
                   Width="16" Height="16"
                   Margin="12,0,8,0"
                   VerticalAlignment="Center"/>
            <TextBlock x:Name="TitleBarTextBlock"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       FontFamily="{StaticResource HarmonyOSRegular}"
                       Grid.Column="2"
                       VerticalAlignment="Center"/>

            <Rectangle Grid.Column="3"
                       HorizontalAlignment="Right"
                       Width="1.18"
                       Margin="0,16,8,16"
                       VerticalAlignment="Stretch"
                       Fill="#40999999"/>

            <Button x:Name="SettingsButton"
                    Grid.Column="3"
                    HorizontalAlignment="Right"
                    Margin="0,0,17.18,0"
                    Style="{StaticResource TitleBarSettingsButtonStyle}"
                    Command="{x:Bind ViewModel.OpenSettingsCommand}">
                <FontIcon Glyph="&#xE713;"
                          FontSize="16"
                          FontFamily="{ThemeResource SymbolThemeFontFamily}" />
            </Button>

            <Button x:Name="MinimizeButton"
                    Grid.Column="4"
                    Style="{StaticResource WindowCaptionButton}"
                    Width="32" Height="32"
                    Margin="0,0,4,0"
                    VerticalAlignment="Center">
                <FontIcon Glyph="&#xE921;"
                          FontSize="10"
                          Foreground="{Binding Foreground, ElementName=MinimizeButton}"/>
            </Button>
            <Button x:Name="MaximizeButton"
                    Grid.Column="5"
                    Style="{StaticResource WindowCaptionButton}"
                    Width="32" Height="32"
                    Margin="0,0,4,0"
                    VerticalAlignment="Center">
                <FontIcon x:Name="MaximizeButtonIcon"
                          Glyph="&#xE922;"
                          FontSize="10"
                          Foreground="{Binding Foreground, ElementName=MaximizeButton}"/>
            </Button>
            <Button x:Name="CloseButton"
                    Grid.Column="6"
                    Style="{StaticResource WindowCaptionCloseButton}"
                    Width="32" Height="32"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center">
                <FontIcon Glyph="&#xE8BB;"
                          FontSize="10"
                          Foreground="{Binding Foreground, ElementName=CloseButton}"/>
            </Button>
        </Grid>

        <views:SettingsPage x:Name="settingsHost"
                            Grid.RowSpan="2" />
    </Grid>
</Window>
