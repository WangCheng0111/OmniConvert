<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OmniConvert.Views.ConverterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:OmniConvert.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Margin="16,0,16,16" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <Border x:Name="MainCard"
                Grid.Column="0"
                AllowDrop="True"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                DragEnter="MainCard_DragEnter"
                DragOver="MainCard_DragOver"
                DragLeave="MainCard_DragLeave"
                Drop="MainCard_Drop">
            <Grid IsHitTestVisible="False">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="20">
                    <Image x:Name="EmptyStateImage"
                           Source="ms-appx:///Assets/Images/empty_state.png"
                           Width="260"
                           Height="165"
                           HorizontalAlignment="Center" />
                    <TextBlock x:Name="DropHintText"
                               Text="把文件丢给我"
                               FontFamily="{StaticResource HarmonyOSRegular}"
                               FontSize="16"
                               Foreground="{StaticResource CardHintForegroundBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>
                <Image x:Name="DropIcon"
                       Source="ms-appx:///Assets/Tiles/GalleryIcon.ico"
                       Width="48"
                       Height="48"
                       Opacity="0"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border x:Name="SideCard"
                Grid.Column="1"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
            <StackPanel Margin="16">
                <TextBlock Text="目标格式"
                           FontFamily="{StaticResource HarmonyOSRegular}"
                           FontSize="13"
                           Foreground="{StaticResource LabelForegroundBrush}"
                           HorizontalAlignment="Left"
                           Margin="0,0,0,10" />

                <controls:CustomComboBox x:Name="TargetFormatBox"
                                         Width="240"
                                         HorizontalAlignment="Center"
                                         PlaceholderText="请选择文件"
                                         IsEnabled="False" />

                <Button x:Name="StartConvertButton"
                        Width="240"
                        Height="32"
                        Margin="0,16,0,0"
                        HorizontalAlignment="Center"
                        Style="{StaticResource StartConvertButtonStyle}"
                        Content="开始转换"
                        IsEnabled="False" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
